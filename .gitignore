# ============================================================
# RSOS / RSSO / RSIA / RSX publication exclusions
# ============================================================

# Credentials / environment
.env
.env.*
*.pem
*.key
*credential*
*password*
*secret*

# Raw / external datasets
*.parquet

# Large archives and compressed estates
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2

# Binary models / serialized objects
*.joblib
*.pkl
*.pickle
*.bin
*.dat

# Local databases
*.db
*.sqlite
*.sqlite3

# Python environment/runtime
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Temporary
*.tmp
*.temp
~*
